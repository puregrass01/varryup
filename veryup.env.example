# VERY UP VER3 - 직원 PC 설정 파일 (견본)
#
# 두는 곳:  %APPDATA%\very-up-ver2\veryup.env
#           (주소창에 %APPDATA%\very-up-ver2 를 붙여넣으면 바로 열린다)
#
# 이 파일은 설치본을 다시 만들지 않고 바꿀 수 있는 유일한 설정 경로다.
# 앱을 껐다 켜야 적용된다. 값에 따옴표는 없어도 되고, 있으면 벗겨진다.
# 셸 환경변수가 이미 있으면 그쪽이 이긴다(개발용).

# ── 자동 업데이트 ─────────────────────────────────────────────
# 서버의 UPDATE_TOKEN 과 **같은 값**이어야 한다. 한쪽만 설정하면
# 업데이트가 404/401 로 조용히 끊긴다.
UPDATE_TOKEN=

# ── 관리자 / 인증키 서버 ──────────────────────────────────────
# 비워 두면 코드에 박힌 기본값(https://admin.veryup-domain.duckdns.org)을 쓴다.
#ADMIN_SERVER_URL=https://admin.veryup-domain.duckdns.org

# 서버를 아예 쓰지 않는 PC (로그인 화면 없이 바로 시작, 인증키는 각 탭에서 직접 입력)
#VERYUP_LOCAL_ONLY=1

# ── AI 이미지 생성 ────────────────────────────────────────────
#AI_SERVER_URL=https://ai.veryup-domain.duckdns.org

# ── 파파고 번역 (관리자 서버에 등록했다면 불필요) ─────────────
#PAPAGO_CLIENT_ID=
#PAPAGO_CLIENT_SECRET=
