# 패키지 (용량 너무 큼, npm install로 재생성 가능)
node_modules/

# 빌드 결과물
dist/

# API 키 / 시크릿 (절대 올리면 안 됨)
data/imweb_openapi_config.json
data/coupang_config.json
data/amazon_config.json
data/papago.json
# PC별 설정 — UPDATE_TOKEN 이 들어 있다. 새 PC 는 veryup.env.example 을 복사해 쓴다.
veryup.env

# 세션 / 로그인 정보
data/esm_session.json
data/session_naver.json
session_naver.json

# 테스트 / 임시 캐시 파일
data/test_cache.json
data/product_*_detail.json

# 임시 / 백업 폴더
scratch/
_cleanup_backup/

# AI 작업 내부 파일
.claude/

# 로그 파일
*.log

# data/defaults 안에 실제 인증키·세션이 들어있어 통째로 제외 (앱은 로컬 파일 그대로 사용)
data/defaults/

# 관리자 서버 실행 데이터 (DB=계정해시/로그, 캐시)
server/admin.db
*.db
__pycache__/
server/secret.key
server/dev_admin_secret.key
server/ebay-queue-dev/
server/.venv/

# eBay per-user encrypted credentials and publishing journal
ebay_config.json
ebay_config.json.tmp
ebay_jobs.json
ebay_jobs.json.tmp

# eBay 계정 삭제 알림 수신 기록 (eBay userId 포함 — 커밋 금지)
server/ebay_deletions.jsonl
server/updates/
server/currency_rates.json
server/currency_rates.tmp

# 베리맵 수집 결과·캐시(약 58MB, 버튼으로 다시 만든다)와 개인 설정(verimap_ui.json, 직원 아이디).
# 다시 만들 수 없는 설정·사전 6개만 추적한다 — docs/베리맵_병합안내.md 1항.
data/verimap/*
!data/verimap/config.json
!data/verimap/model_names.json
!data/verimap/model_aliases.json
!data/verimap/part_aliases.json
!data/verimap/verimap_links.json
!data/verimap/manual_links.json
